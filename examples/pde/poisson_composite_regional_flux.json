{
  "Verbosity": {
    "level": 2
  },
  "NeuralNetwork": {
    "Architecture": {
      "mpnn_type": "CompositeNeuralOperator",
      "hidden_dim": 48,
      "num_conv_layers": 4,
      "activation_function": "silu",
      "equivariance": false,
      "freeze_conv_layers": false,
      "initial_bias": null,
      "max_neighbours": null,
      "edge_dim": null,
      "output_heads": {
        "node": {
          "num_headlayers": 1,
          "dim_headlayers": [
            48
          ],
          "type": "mlp"
        }
      },
      "task_weights": [
        1.0,
        1.0
      ],
      "composite_encoder": {
        "type": "RegionalGraphEncoder"
      },
      "composite_processors": [
        {
          "type": "RegionalMessagePassing",
          "layers": 4
        },
        {
          "type": "RegionToNode"
        },
        {
          "type": "LocalMessagePassing",
          "layers": 2,
          "skip": true
        }
      ],
      "composite_decoders": {
        "face": "ConservativeFluxDecoder"
      },
      "composite_spatial_dim": 2
    },
    "Training": {
      "num_epoch": 60,
      "perc_train": 0.8,
      "loss_function_type": "mse",
      "batch_size": 16,
      "continue": 0,
      "startfrom": "existing_model",
      "conv_checkpointing": false,
      "Optimizer": {
        "type": "AdamW",
        "learning_rate": 0.001
      }
    }
  },
  "Visualization": {
    "plot_init_solution": false,
    "plot_hist_solution": false,
    "create_plots": false
  },
  "Variables": {
    "graph_type": "homogeneous",
    "inputs": [
      {
        "name": "pos",
        "role": "position",
        "level": "node",
        "dim": 2
      },
      {
        "name": "f",
        "level": "node",
        "dim": 1,
        "normalize": "scale_only"
      },
      {
        "name": "boundary",
        "level": "node",
        "dim": 1
      }
    ],
    "outputs": [
      {
        "name": "u",
        "level": "node",
        "dim": 1
      },
      {
        "name": "q",
        "level": "face",
        "dim": 1,
        "normalize": "scale_only"
      }
    ],
    "spatial_dim": 2
  }
}
