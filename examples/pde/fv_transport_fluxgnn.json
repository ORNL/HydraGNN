{
  "Verbosity": {"level": 2},
  "NeuralNetwork": {
    "Architecture": {
      "mpnn_type": "FluxGNN",
      "hidden_dim": 16,
      "num_conv_layers": 4,
      "fluxgnn_dt": 0.02,
      "fluxgnn_mlp_layers": 2,
      "fluxgnn_advection": true,
      "fluxgnn_diffusion": true,
      "fluxgnn_boundary": "learned",
      "fluxgnn_source": true,
      "fluxgnn_vector_inputs": ["v"],
      "fluxgnn_scalar_inputs": ["s"],
      "activation_function": "relu",
      "equivariance": false,
      "freeze_conv_layers": false,
      "initial_bias": null,
      "max_neighbours": null,
      "edge_dim": null,
      "output_heads": {"node": {"num_headlayers": 1, "dim_headlayers": [16], "type": "mlp"}},
      "task_weights": [1.0]
    },
    "Training": {
      "num_epoch": 30,
      "perc_train": 0.8,
      "loss_function_type": "mse",
      "batch_size": 16,
      "continue": 0,
      "startfrom": "existing_model",
      "conv_checkpointing": false,
      "precision": "fp64",
      "Optimizer": {"type": "AdamW", "learning_rate": 0.002}
    }
  },
  "Visualization": {"plot_init_solution": false, "plot_hist_solution": false, "create_plots": false},
  "Variables": {
    "graph_type": "homogeneous",
    "inputs": [
      {"name": "pos", "role": "position", "level": "node", "dim": 2},
      {"name": "u", "level": "cell", "dim": 1},
      {"name": "v", "level": "cell", "dim": 2},
      {"name": "s", "level": "cell", "dim": 1, "normalize": "scale_only"}
    ],
    "outputs": [{"name": "u_next", "level": "cell", "dim": 1}],
    "spatial_dim": 2
  }
}
