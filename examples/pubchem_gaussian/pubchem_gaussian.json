{
    "Verbosity": {
        "level": 2
    },
    "NeuralNetwork": {
        "Architecture": {
            "mpnn_type": "SchNet",
            "enable_interatomic_potential": true,
            "energy_weight": 1.0,
            "energy_peratom_weight": 0.0,
            "force_weight": 1.0,
            "hessian_weight": 1.0,
            "graph_pooling": "add",
            "edge_features": [],
            "max_neighbours": 64,
            "num_gaussians": 32,
            "num_filters": 64,
            "radius": 11.3383567527,
            "hidden_dim": 128,
            "num_conv_layers": 4,
            "output_heads": {
                "graph": {
                    "num_sharedlayers": 1,
                    "dim_sharedlayers": 128,
                    "num_headlayers": 2,
                    "dim_headlayers": [
                        128,
                        128
                    ],
                    "type": "mlp"
                }
            },
            "task_weights": [
                1.0
            ]
        },
        "Training": {
            "Checkpoint": true,
            "num_epoch": 20,
            "batch_size": 1,
            "continue": 0,
            "loss_function_type": "mse",
            "Optimizer": {
                "learning_rate": 0.001
            }
        }
    },
    "Variables": {
        "inputs": [
            {
                "name": "atomic_numbers",
                "encoding": {
                    "type": "embedding",
                    "num_categories": 118,
                    "embedding_dim": 128,
                    "min_value": 1
                },
                "level": "node",
                "dim": 1
            },
            {
                "name": "pos",
                "role": "position",
                "level": "node",
                "dim": 3
            }
        ],
        "outputs": [
            {
                "name": "energy",
                "level": "graph",
                "dim": 1
            }
        ]
    }
}