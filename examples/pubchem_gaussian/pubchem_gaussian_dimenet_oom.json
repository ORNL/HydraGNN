{
    "Verbosity": {"level": 2},
    "NeuralNetwork": {
        "Architecture": {
            "mpnn_type": "DimeNet",
            "enable_interatomic_potential": true,
            "energy_weight": 10.0,
            "energy_peratom_weight": 0.0,
            "force_weight": 10.0,
            "hessian_weight": 10.0,
            "graph_pooling": "add",
            "edge_features": [],
            "max_neighbours": 64,
            "num_gaussians": 32,
            "num_filters": 64,
            "radius": 11.3383567527,
            "hidden_dim": 128,
            "num_conv_layers": 3,
            "output_heads": {
                "graph": {
                    "num_sharedlayers": 1,
                    "dim_sharedlayers": 128,
                    "num_headlayers": 2,
                    "dim_headlayers": [128, 128],
                    "type": "mlp"
                },
                "node": {
                    "num_headlayers": 2,
                    "dim_headlayers": [128, 128],
                    "type": "mlp"
                }
            },
            "task_weights": [1.0],
            "equivariant_attn_num_hidden_layers": 3,
            "equivariant_attn_feedforward_multiplier": 4,
            "global_attn_engine": "EquivariantTransformer",
            "global_attn_type": "",
            "global_attn_heads": 4,
            "equivariant_attn_allow_scalar_only": true,
            "equivariant_attn_require_tensor_coupling": false,
            "basis_emb_size": 8,
            "envelope_exponent": 5,
            "int_emb_size": 64,
            "out_emb_size": 128,
            "num_after_skip": 2,
            "num_before_skip": 1,
            "num_radial": 6,
            "num_spherical": 7
        },
        "Training": {
            "Checkpoint": false,
            "num_epoch": 1,
            "batch_size": 1,
            "continue": 0,
            "loss_function_type": "mse",
            "Optimizer": {"learning_rate": 0.001}
        }
    },
    "Variables": {
        "inputs": [
            {
                "name": "atomic_numbers",
                "encoding": {
                    "type": "embedding",
                    "num_categories": 118,
                    "embedding_dim": 128,
                    "min_value": 1
                },
                "level": "node",
                "dim": 1
            },
            {"name": "pos", "role": "position", "level": "node", "dim": 3},
            {"name": "total_charge", "level": "graph", "dim": 1},
            {"name": "spin_multiplicity", "level": "graph", "dim": 1}
        ],
        "outputs": [
            {"name": "energy", "level": "graph", "dim": 1}
        ]
    }
}