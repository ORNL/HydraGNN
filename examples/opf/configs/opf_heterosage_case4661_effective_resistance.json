{
    "Verbosity": {
        "level": 1
    },
    "NeuralNetwork": {
        "Architecture": {
            "mpnn_type": "HeteroSAGE",
            "hidden_dim": 64,
            "num_conv_layers": 4,
            "pe_dim": 0,
            "max_neighbours": 100,
            "global_attn_engine": "GPS",
            "global_attn_type": "multihead",
            "global_attn_heads": 4,
            "attn_only": false,
            "attn_node_types": [
                "bus"
            ],
            "hetero_attention_heads": 4,
            "node_input_dims": {
                "bus": 4,
                "generator": 11,
                "load": 2,
                "shunt": 2
            },
            "output_heads": {
                "node": {
                    "num_headlayers": 2,
                    "dim_headlayers": [
                        32,
                        16
                    ],
                    "type": "mlp"
                }
            },
            "task_weights": [
                1.0
            ],
            "hetero_pooling_mode": "sum",
            "node_target_type": "bus",
            "hetero_edge_type_emb_dim": 16,
            "hetero_edge_attr_emb_dim": 16,
            "activation_function": "relu",
            "hetero_attention_negative_slope": 0.2,
            "SyncBatchNorm": false,
            "edge_types": [
                {
                    "source_type": "bus",
                    "relation": "ac_line",
                    "target_type": "bus",
                    "dim": 9
                },
                {
                    "source_type": "bus",
                    "relation": "transformer",
                    "target_type": "bus",
                    "dim": 11
                },
                {
                    "source_type": "generator",
                    "relation": "generator_link",
                    "target_type": "bus",
                    "dim": 0
                },
                {
                    "source_type": "bus",
                    "relation": "generator_link",
                    "target_type": "generator",
                    "dim": 0
                },
                {
                    "source_type": "load",
                    "relation": "load_link",
                    "target_type": "bus",
                    "dim": 0
                },
                {
                    "source_type": "bus",
                    "relation": "load_link",
                    "target_type": "load",
                    "dim": 0
                },
                {
                    "source_type": "shunt",
                    "relation": "shunt_link",
                    "target_type": "bus",
                    "dim": 0
                },
                {
                    "source_type": "bus",
                    "relation": "shunt_link",
                    "target_type": "shunt",
                    "dim": 0
                }
            ],
            "opf_preprocessing": {
                "precompute": [
                    "laplacian",
                    "effective_resistance"
                ],
                "use": [
                    "effective_resistance"
                ],
                "cache_by_case": true,
                "compute_device": "auto",
                "laplacian": {
                    "dim": 8,
                    "eigenvector_selection": "smallest_nonzero",
                    "relative_tolerance": null,
                    "random_sign_flip": false
                },
                "effective_resistance": {
                    "statistics": [
                        "min",
                        "max",
                        "std",
                        "median",
                        "mean"
                    ],
                    "std_correction": 0
                },
                "target_node_type": "bus"
            },
            "structural_encoding": {
                "target_node_type": "bus",
                "node_inputs": [
                    {
                        "attribute": "effective_resistance_pe",
                        "dim": 5
                    }
                ]
            }
        },
        "Training": {
            "num_epoch": 50,
            "batch_size": 1,
            "patience": 10,
            "early_stopping": true,
            "Checkpoint": true,
            "checkpoint_warmup": 1,
            "continue": 0,
            "startfrom": "existing_model",
            "Optimizer": {
                "type": "AdamW",
                "learning_rate": 0.001
            },
            "conv_checkpointing": false,
            "loss_function_type": "mse",
            "precision": "fp32"
        }
    },
    "Visualization": {
        "plot_init_solution": false,
        "plot_hist_solution": false,
        "create_plots": false
    },
    "Variables": {
        "graph_type": "heterogeneous",
        "node_types": [
            "bus",
            "generator",
            "load",
            "shunt"
        ],
        "inputs": [
