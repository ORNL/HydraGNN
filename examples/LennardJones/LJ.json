{
    "Verbosity": {
        "level": 2
    },
    "Dataset": {
        "name": "LJdataset",
        "format": "XYZ"
    },
    "NeuralNetwork": {
        "Architecture": {
            "periodic_boundary_conditions": true,
            "mpnn_type": "DimeNet",
            "radius": 5.0,
            "max_neighbours": 5,
            "int_emb_size": 32,
            "out_emb_size": 16,
            "basis_emb_size": 8,
            "num_gaussians": 10,
            "num_filters": 8,
            "num_before_skip": 1,
            "num_after_skip": 1,
            "envelope_exponent": 5,
            "max_ell": 1,
            "node_max_ell": 1,
            "num_radial": 5,
            "num_spherical": 2,
            "hidden_dim": 32,
            "num_conv_layers": 4,
            "output_heads": {
                "node": {
                    "num_headlayers": 2,
                    "dim_headlayers": [
                        60,
                        20
                    ],
                    "type": "mlp"
                }
            },
            "task_weights": [
                1
            ]
        },
        "Training": {
            "num_epoch": 25,
            "batch_size": 64,
            "perc_train": 0.7,
            "patience": 20,
            "early_stopping": true,
            "Optimizer": {
                "type": "Adam",
                "learning_rate": 0.005
            },
            "conv_checkpointing": false,
            "loss": {
                "enabled": true,
                "provider": "interatomic_potential",
                "supervised": {
                    "default_metric": "mse",
                    "terms": [
                        {
                            "variable": "energy",
                            "weight": 1.0,
                            "normalization": "per_structure"
                        },
                        {
                            "variable": "energy_per_atom",
                            "weight": 1.0,
                            "normalization": "per_atom"
                        },
                        {
                            "variable": "forces",
                            "weight": 1.0,
                            "prediction": {
                                "operator": "negative_gradient",
                                "of": "energy",
                                "with_respect_to": "positions"
                            }
                        }
                    ]
                },
                "constraints": [],
                "constraint_optimizer": {
                    "type": "fixed_penalty"
                }
            }
        }
    },
    "Visualization": {
        "plot_init_solution": true,
        "plot_hist_solution": true,
        "create_plots": true
    },
    "Variables": {
        "graph_type": "homogeneous",
        "inputs": [
            {
                "name": "atomic_numbers",
                "encoding": {
                    "type": "embedding",
                    "num_categories": 118,
                    "embedding_dim": 32,
                    "min_value": 1
                },
                "level": "node",
                "dim": 1
            },
            {
                "name": "pos",
                "role": "position",
                "level": "node",
                "dim": 3
            }
        ],
        "outputs": [
            {
                "name": "potential",
                "level": "node",
                "dim": 1
            }
        ]
    }
}
