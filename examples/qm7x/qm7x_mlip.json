{
    "Verbosity": {
        "level": 2
    },
    "NeuralNetwork": {
        "Architecture": {
            "mpnn_type": "EGNN",
            "equivariance": true,
            "max_neighbours": 50,
            "num_gaussians": 50,
            "num_filters": 50,
            "envelope_exponent": 5,
            "int_emb_size": 64,
            "basis_emb_size": 8,
            "out_emb_size": 128,
            "num_after_skip": 2,
            "num_before_skip": 1,
            "num_radial": 6,
            "num_spherical": 7,
            "radius": 5.0,
            "hidden_dim": 200,
            "num_conv_layers": 4,
            "output_heads": {
                "node": {
                    "num_headlayers": 2,
                    "dim_headlayers": [
                        100,
                        100
                    ],
                    "type": "mlp"
                }
            },
            "task_weights": [
                1
            ]
        },
        "Training": {
            "Checkpoint": true,
            "num_epoch": 20,
            "batch_size": 32,
            "continue": 0,
            "startfrom": "./logs/qm7x/qm7x",
            "Optimizer": {
                "learning_rate": 0.001
            },
            "loss": {
                "enabled": true,
                "provider": "interatomic_potential",
                "supervised": {
                    "default_metric": "mse",
                    "terms": [
                        {
                            "variable": "energy",
                            "weight": 1.0,
                            "normalization": "per_structure"
                        },
                        {
                            "variable": "energy_per_atom",
                            "weight": 1.0,
                            "normalization": "per_atom"
                        },
                        {
                            "variable": "forces",
                            "weight": 1.0,
                            "prediction": {
                                "operator": "negative_gradient",
                                "of": "energy",
                                "with_respect_to": "positions"
                            }
                        }
                    ]
                },
                "constraints": [],
                "constraint_optimizer": {
                    "type": "fixed_penalty"
                }
            }
        }
    },
    "Variables": {
        "graph_type": "homogeneous",
        "inputs": [
            {
                "name": "atomic_numbers",
                "encoding": {
                    "type": "embedding",
                    "num_categories": 118,
                    "embedding_dim": 200,
                    "min_value": 1
                },
                "level": "node",
                "dim": 1
            },
            {
                "name": "pos",
                "role": "position",
                "level": "node",
                "dim": 3
            }
        ],
        "outputs": [
            {
                "name": "graph_energy",
                "level": "node",
                "dim": 1
            }
        ]
    }
}
